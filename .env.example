# Motor de voz principal: OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY="sk-or-..."

# Opcional: modelo por defecto en OpenRouter (se puede cambiar por proyecto en la app)
OPENROUTER_TTS_MODEL="google/gemini-3.8-flash-tts"

# Opcional: Gemini directo de Google, como motor alternativo (https://aistudio.google.com/apikey)
# GEMINI_API_KEY="..."
# GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"

# Opcional: protege la app con usuario y contraseña (recomendado si el servidor es público)
# APP_USER="admin"
# APP_PASSWORD="una-clave-larga"

# Opcional: carpeta donde se guardan los proyectos y sus audios (por defecto ./data/projects)
DATA_DIR="data/projects"

# Opcional: puerto del servidor (por defecto 3000)
PORT=3000
