# Clave de la API de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY="TU_CLAVE_DE_GEMINI"

# Opcional: modelo de voz. Usa "gemini-2.5-pro-preview-tts" para mayor calidad.
GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"

# Opcional: puerto del servidor (por defecto 3000)
PORT=3000

# Opcional: carpeta donde se guardan los proyectos y sus audios (por defecto ./data/projects)
DATA_DIR="data/projects"
