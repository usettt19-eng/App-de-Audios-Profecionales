# Motor de voz principal: OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY="sk-or-..."

# Opcional: modelo por defecto en OpenRouter (se puede cambiar por proyecto en la app)
OPENROUTER_TTS_MODEL="google/gemini-3.8-flash-tts"

# Opcional: modelo de texto por defecto para escribir guiones (si no, se elige uno recomendado disponible)
# OPENROUTER_TEXT_MODEL="anthropic/claude-sonnet-5"

# Opcional: modelo de imagen por defecto (si no, se elige uno recomendado disponible, p. ej. Seedream)
# OPENROUTER_IMAGE_MODEL="bytedance-seed/seedream-4.5"
# Música de fondo (opcional). Por defecto google/lyria-3-pro-preview.
# OPENROUTER_MUSIC_MODEL="google/lyria-3-pro-preview"

# Opcional: clave de YouTube Data API v3 para analizar canales con datos exactos en Ideas
# (sin ella se usa la búsqueda web de OpenRouter). https://console.cloud.google.com/apis/library/youtube.googleapis.com
# YOUTUBE_API_KEY="..."

# Opcional: Gemini directo de Google, como motor alternativo (https://aistudio.google.com/apikey)
# GEMINI_API_KEY="..."
# GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"

# Opcional: protege la app con usuario y contraseña (recomendado si el servidor es público)
# APP_USER="admin"
# APP_PASSWORD="una-clave-larga"

# Opcional: hilos de ffmpeg para montar el video (por defecto 2, para no saturar el servidor)
# VIDEO_THREADS=2

# Opcional: carpeta donde se guardan los proyectos y sus audios (por defecto ./data/projects)
DATA_DIR="data/projects"

# Opcional: puerto del servidor (por defecto 3000)
PORT=3000
